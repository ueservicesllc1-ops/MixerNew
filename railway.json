{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "watchPatterns": [
      "src/**",
      "server/**",
      "electron/**",
      "package.json",
      "package-lock.json",
      "vite.config.js"
    ],
    "ignorePatterns": [
      "ios/**",
      "android/**",
      "codemagic.yaml",
      "scratch/**",
      "*.md"
    ]
  }
}
